# Gold Mine Lab backend — copy to .env for local dev (optional; the app reads
# the real environment). Placeholder values only — never commit real secrets.

APP_ENV=dev                     # dev | prod | test
HTTP_PORT=8080
LOG_LEVEL=info                  # debug | info | warn | error

# Required — no default. Credentials for the local dev database.
# Container maps to host port 5433 (avoids clashing with local Postgres on 5432).
DATABASE_URL=postgres://goldmine:goldmine@localhost:5433/goldmine?sslmode=disable

DB_MAX_CONNS=10
DB_MIN_CONNS=2

HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
SHUTDOWN_TIMEOUT=15s

# Comma-separated frontend origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional: directory holding historical CSVs (XAU_1h_data.csv etc.).
# When set, real candle history is served for covered assets (XAUUSD).
MARKET_DATA_DIR=../data

# --- Live market data (optional — observational only) -----------------------
# Streams real XAU/USD quotes from Twelve Data into /api/market/live/*.
# The key stays server-side; the frontend only sees backend responses.
LIVE_MARKET_ENABLED=false            # true to enable the live provider
LIVE_MARKET_PROVIDER=twelvedata      # only "twelvedata" is supported
LIVE_MARKET_TRANSPORT=rest           # rest | websocket — rest polls /quote, no WS plan needed
LIVE_MARKET_POLL_INTERVAL=10s        # REST quote cadence (5s–10m); 10s ≈ 8,640 credits/day
LIVE_MARKET_CANDLE_RECONCILE_INTERVAL=5m  # per-timeframe REST refresh (30s–1h); 5m ≈ 1,728 credits/day
LIVE_MARKET_DAILY_CREDIT_LIMIT=800   # plan allowance used for the startup usage warning
TWELVE_DATA_API_KEY=                 # get one at https://twelvedata.com (never commit)
LIVE_MARKET_SYMBOL=XAU/USD           # provider symbol for XAUUSD
LIVE_MARKET_STALE_AFTER=30s          # quote age before status reports "stale"
# Endpoint overrides — for tests/mocks only, leave unset in normal use.
# TWELVE_DATA_REST_URL=https://api.twelvedata.com
# TWELVE_DATA_WS_URL=wss://ws.twelvedata.com/v1/quotes/price
