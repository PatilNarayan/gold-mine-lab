# Public configuration only — VITE_* variables are bundled into client code.
# Never place secrets or credentials here.

VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws
# api (default) wires real backend services; mock is dev/test opt-in only —
# it fabricates every value and is never selected silently.
VITE_DATA_MODE=api         # api | mock
